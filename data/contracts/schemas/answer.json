{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answer.json",
  "title": "AnswerEnvelope",
  "type": "object",
  "required": [
    "answer",
    "citations",
    "trace_id",
    "timings",
    "cost",
    "model_id",
    "index_version",
    "retrieved"
  ],
  "properties": {
    "answer": { "type": "string" },
    "citations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trace_id": { "type": "string" },
    "timings": {
      "type": "object",
      "properties": {
        "retrieve_ms": { "type": "number" },
        "generate_ms": { "type": "number" }
      },
      "required": ["retrieve_ms", "generate_ms"]
    },
    "cost": { "type": "object" },
    "model_id": { "type": "string" },
    "index_version": { "type": "string" },
    "retrieved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "score", "text"],
        "properties": {
          "chunk_id": { "type": "string" },
          "start_ts": { "type": "number" },
          "end_ts": { "type": "number" },
          "score": { "type": "number" },
          "text": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
