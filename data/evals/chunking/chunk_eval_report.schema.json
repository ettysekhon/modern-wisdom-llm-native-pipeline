{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mw.local/schemas/chunk_eval_report.schema.json",
  "title": "Spike 3 Chunking Eval Report",
  "type": "object",
  "required": [
    "episode_id",
    "evaluated_methods",
    "k",
    "tolerance_s",
    "metrics",
    "winner",
    "selection",
    "dataset",
    "version",
    "created_at"
  ],
  "properties": {
    "episode_id": { "type": "string", "minLength": 1 },

    "evaluated_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["fixed", "sentence_bound", "time_window", "speaker"]
      },
      "uniqueItems": true
    },

    "k": { "type": "integer", "minimum": 1 },
    "tolerance_s": { "type": "integer", "minimum": 0 },

    "params": {
      "type": "object",
      "description": "Global params used to generate chunks (for reference)",
      "properties": {
        "size_tokens": { "type": "integer", "minimum": 1 },
        "overlap_tokens": { "type": "integer", "minimum": 0 },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "overlap_seconds": { "type": "integer", "minimum": 0 },
        "chunk_v": { "type": "string" }
      },
      "additionalProperties": false
    },

    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["Hit@5", "Hit@10", "Hit@20", "MRR", "Coverage"],
        "properties": {
          "Hit@5": { "type": "number", "minimum": 0, "maximum": 1 },
          "Hit@10": { "type": "number", "minimum": 0, "maximum": 1 },
          "Hit@20": { "type": "number", "minimum": 0, "maximum": 1 },
          "MRR": { "type": "number", "minimum": 0, "maximum": 1 },
          "Coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "AvgTimeDistanceSec": { "type": ["number", "null"], "minimum": 0 },
          "AvgTokens": { "type": ["number", "null"], "minimum": 0 },
          "AvgDurationSec": { "type": ["number", "null"], "minimum": 0 },
          "Notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "winner": {
      "type": "string",
      "enum": ["fixed", "sentence_bound", "time_window", "speaker"]
    },

    "selection": {
      "type": "object",
      "required": ["criterion", "tie_breaker"],
      "properties": {
        "criterion": {
          "type": "string",
          "enum": ["Hit@10", "Hit@5", "Hit@20"]
        },
        "tie_breaker": {
          "type": "string",
          "enum": ["MRR", "AvgTimeDistanceSec"]
        },
        "improvement_vs_baseline_pct": { "type": ["number", "null"] },
        "baseline": {
          "type": "string",
          "enum": ["fixed", "sentence_bound", "time_window", "speaker"]
        }
      },
      "additionalProperties": false
    },

    "dataset": {
      "type": "object",
      "required": ["qa_count", "qa_source", "overlap_tolerance_s"],
      "properties": {
        "qa_count": { "type": "integer", "minimum": 1 },
        "qa_source": { "type": "string" },
        "overlap_tolerance_s": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "acceptance": {
      "type": "object",
      "required": ["passed"],
      "properties": {
        "passed": { "type": "boolean" },
        "reason": { "type": "string" },
        "thresholds": {
          "type": "object",
          "properties": {
            "min_improvement_hit10_pct": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
